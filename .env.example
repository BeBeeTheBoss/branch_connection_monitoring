APP_NAME=BeePing
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://monitor.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Yangon
APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=netpulse
DB_USERNAME=netpulse
DB_PASSWORD=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
PING_BINARY=/bin/ping
MONITORING_QUEUE=monitoring
MONITORING_HISTORY_RETENTION_DAYS=30
DOWN_NOTIFICATION_DELAY_MINUTES=5
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS=alerts@example.com
MAIL_FROM_NAME=BeePing
VITE_APP_NAME=BeePing
